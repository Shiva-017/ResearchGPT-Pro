[Unit]
Description=ResearchGPT Pro Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ResearchGPT-Pro
EnvironmentFile=/home/ubuntu/ResearchGPT-Pro/.env
ExecStart=/usr/bin/python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

# Memory limit for t2.micro
MemoryMax=400M

# Logging
StandardOutput=append:/home/ubuntu/ResearchGPT-Pro/backend/data/logs/backend.log
StandardError=append:/home/ubuntu/ResearchGPT-Pro/backend/data/logs/backend.log

[Install]
WantedBy=multi-user.target
